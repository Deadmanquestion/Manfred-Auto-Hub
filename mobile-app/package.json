{
  "name": "@manfred/mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start",
    "admin": "npm --prefix .. run admin",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
    "eas:configure": "npx eas-cli@latest build:configure",
    "build:android": "npx eas-cli@latest build -p android",
    "build:ios": "npx eas-cli@latest build -p ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~56.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  }
}
